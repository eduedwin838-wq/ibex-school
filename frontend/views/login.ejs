<%- include('_header') %>
<style>
  .auth-card { width: min(440px, 100%); margin: 52px auto; padding: 34px; }
  .auth-card h1 { margin-bottom: 8px; text-align: center; }
  .auth-subtitle { margin: 0 0 24px; color: #657386; text-align: center; }
  .auth-card form { display: grid; gap: 14px; }
  .auth-card form button { width: 100%; margin-top: 5px; }
  .auth-message { padding: 12px 14px; border: 1px solid #c8dfd1; border-radius: 5px; background: #f1f8f3; color: #285a3b; font-size: 13px; }
  .auth-error { border-color: #e5c7c7; background: #fbf2f2; color: #873b3b; }
  .auth-footnote { margin: 20px 0 0; text-align: center; font-size: 13px; }
  .auth-footnote a { color: #285b87; font-weight: 600; text-decoration: none; }
  @media (max-width: 600px) { .auth-card { margin: 28px auto; padding: 24px; } }
</style>
<main>
  <section class="panel auth-card">
    <h1>Welcome back</h1>
    <p class="auth-subtitle">Sign in to your Ibex Student System account.</p>
    <% if (registered) { %><p class="auth-message">Account created. Please log in.</p><% } %>
    <% if (error) { %><p class="auth-message auth-error"><%= error %></p><% } %>
    <form action="/login" method="POST">
      <label>Email<input name="email" type="email" placeholder="Email address" required></label>
      <label>Password<input name="password" type="password" placeholder="Password" required></label>
      <button type="submit">Login</button>
    </form>
    <p class="auth-footnote">No account? <a href="/register">Register</a></p>
  </section>
</main>
<%- include('_footer') %>
