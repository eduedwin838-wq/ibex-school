<%- include('_header', { user }) %>
<style>
  .grade-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .grade-form button { align-self: end; }
  .badge { display: inline-flex; padding: 5px 10px; border-radius: 999px; background: #24234B; color: #C7D2FE; font-size: 12px; font-weight: 700; text-transform: capitalize; }
  @media (max-width: 600px) { .grade-form { grid-template-columns: 1fr; } }
</style>
<main>
  <% if (['admin','teacher'].includes(user.role)) { %>
    <section class="panel">
      <h1>Add Grade</h1>
      <form class="grade-form" method="POST" action="/grades/add">
        <label>Student<select name="studentId" required><option value="">Select student</option><% students.forEach(student => { %><option value="<%= student.id %>" <%= String(selectedStudentId) === String(student.id) ? 'selected' : '' %>><%= student.name %> (<%= student.admissionNo %>)</option><% }) %></select></label>
        <label>Subject<input name="subject" placeholder="Subject" required></label>
        <label>Term<input name="term" placeholder="Term" required></label>
        <label>Score<input name="score" type="number" min="0" max="100" placeholder="Score" required></label>
        <button type="submit">Save Grade</button>
      </form>
    </section>
  <% } %>
  <section class="panel">
    <h1><%= user.role === 'student' ? 'My Grades' : user.role === 'parent' ? 'Child Grades' : 'Grades' %></h1>
    <% if (grades.length) { %>
      <div class="table-wrap"><table><thead><tr><th>Student</th><th>Subject</th><th>Term</th><th>Score</th></tr></thead><tbody>
        <% grades.forEach(grade => { %><tr><td><%= grade.student_name %></td><td><%= grade.subject %></td><td><%= grade.term %></td><td><%= grade.score %></td></tr><% }) %>
      </tbody></table></div>
    <% } else { %><p>No grades found.</p><% } %>
  </section>
</main>
<%- include('_footer') %>
