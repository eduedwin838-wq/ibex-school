<%- include('_header', { user, termOptions, selectedTerm }) %>
<% if (user.role === 'admin') { %><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><% } %>
<style>
  .dashboard-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
  .dashboard-title h1 { margin-bottom: 5px; }
  .dashboard-title p { margin: 0; color: #64748b; font-size: 13px; }
  .kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px; }
  .kpi-card { min-width: 0; padding: 18px; border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; box-shadow: 0 8px 24px rgba(15,23,42,.05); }
  .kpi-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: #64748b; font-size: 12px; font-weight: 500; }
  .kpi-icon { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 11px; background: #dcfce7; color: #15803d; }
  .kpi-card:nth-child(2) .kpi-icon { background: #ffedd5; color: #c2410c; }
  .kpi-value { margin: 12px 0 5px; color: #17212b; font-size: clamp(1.45rem, 2.5vw, 1.9rem); font-weight: 700; letter-spacing: -.04em; }
  .kpi-note { margin: 0; color: #64748b; font-size: 11px; }
  .dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(280px, 1fr); gap: 18px; margin-bottom: 18px; }
  .dashboard-panel { min-width: 0; padding: 20px; }
  .dashboard-panel h2 { margin-bottom: 5px; }
  .panel-note { margin: 0 0 16px; color: #64748b; font-size: 11px; }
  .chart-container { position: relative; height: 280px; }
  .table-wrap { margin-top: 12px; }
  .quick-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .quick-actions .button { min-height: 48px; }
  .balance-alert { color: #dc2626; font-weight: 700; }
  .empty-state { padding: 20px; color: #64748b; text-align: center; font-size: 12px; }
  .portal-summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .portal-item { padding: 15px; border: 1px solid #e2e8f0; border-radius: 12px; }
  .portal-item strong { display: block; margin-top: 6px; font-size: 18px; }
  .portal-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  @media (max-width: 1000px) { .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .dashboard-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .kpi-grid, .portal-summary { grid-template-columns: 1fr; } .quick-actions { grid-template-columns: 1fr; } .dashboard-title { flex-direction: column; } }
</style>

<main class="dashboard">
  <div class="dashboard-title">
    <div><h1>Welcome, <%= user.name %></h1><p>Your school at a glance.</p></div>
    <% if (user.role === 'admin') { %><a class="button" href="/reports"><i class="fa-solid fa-file-lines" aria-hidden="true"></i>View reports</a><% } %>
  </div>

  <% if (user.role === 'admin') { %>
    <section class="kpi-grid" aria-label="School overview">
      <article class="kpi-card"><div class="kpi-top"><span>Total Students</span><span class="kpi-icon"><i class="fa-solid fa-user-graduate" aria-hidden="true"></i></span></div><p class="kpi-value"><%= Number(data.totalStudents || 0).toLocaleString() %></p><p class="kpi-note">Currently enrolled</p></article>
      <article class="kpi-card"><div class="kpi-top"><span>Fees Collected</span><span class="kpi-icon"><i class="fa-solid fa-coins" aria-hidden="true"></i></span></div><p class="kpi-value">KES <%= Number(data.totalFeesCollected || 0).toLocaleString() %></p><p class="kpi-note"><%= selectedTerm || 'All terms' %> · <span id="feesCollectedTrend">recorded total</span></p></article>
      <article class="kpi-card"><div class="kpi-top"><span>Fees Balance</span><span class="kpi-icon"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span></div><p class="kpi-value">KES <%= Number(data.totalFeesPending || 0).toLocaleString() %></p><p class="kpi-note">Outstanding · <span id="feesBalanceTrend"><%= selectedTerm || 'all terms' %></span></p></article>
      <article class="kpi-card"><div class="kpi-top"><span>Attendance Today</span><span class="kpi-icon"><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i></span></div><p class="kpi-value"><%= Number(data.attendanceToday?.percentage || 0) %>%</p><p class="kpi-note"><%= data.attendanceToday?.present || 0 %> present or late of <%= data.attendanceToday?.recorded || 0 %> marked · <span><%= data.attendanceToday?.changePoints == null ? 'today' : `${data.attendanceToday.changePoints > 0 ? '+' : ''}${data.attendanceToday.changePoints} pp vs previous marked day` %></span></p></article>
    </section>

    <section class="dashboard-grid">
      <article class="panel dashboard-panel">
        <h2>Fee Collection</h2>
        <p class="panel-note">Collected totals by fee term. Payment dates are not stored separately yet.</p>
        <div class="chart-container"><canvas id="feeCollectionChart" aria-label="Fee collection totals by term"></canvas></div>
      </article>
      <article class="panel dashboard-panel">
        <h2>Recent Payments</h2>
        <p class="panel-note">Paid-to-date amounts on recent fee accounts, not individual transactions.</p>
        <% if (data.recentPayments?.length) { %>
          <div class="table-wrap"><table><thead><tr><th>Student</th><th>Term</th><th>Paid to date</th></tr></thead><tbody>
            <% data.recentPayments.forEach(payment => { %><tr><td><%= payment.student_name %><br><small><%= payment.admissionNo %></small></td><td><%= payment.term %></td><td>KES <%= Number(payment.paid_amount || 0).toLocaleString() %></td></tr><% }) %>
          </tbody></table></div>
        <% } else { %><div class="empty-state">No payments have been recorded yet.</div><% } %>
      </article>
    </section>

    <section class="dashboard-grid">
      <article class="panel dashboard-panel" id="defaulters">
        <h2>Top Defaulters</h2>
        <p class="panel-note">Students with the largest outstanding balance.</p>
        <% if (data.topDefaulters?.length) { %>
          <div class="table-wrap"><table><thead><tr><th>Student</th><th>Class</th><th>Balance</th><th>Action</th></tr></thead><tbody>
            <% data.topDefaulters.forEach(student => { %><tr><td><%= student.student_name %><br><small><%= student.admissionNo %></small></td><td><%= student.class || '—' %></td><td class="balance-alert">KES <%= Number(student.balance || 0).toLocaleString() %></td><td><button class="secondary sms-button" type="button" data-student-id="<%= student.student_id %>"><i class="fa-regular fa-comment-dots" aria-hidden="true"></i>Send SMS</button></td></tr><% }) %>
          </tbody></table></div>
        <% } else { %><div class="empty-state">No outstanding balances for this term.</div><% } %>
      </article>
      <article class="panel dashboard-panel">
        <h2>Quick Actions</h2>
        <p class="panel-note">Common school office tasks.</p>
        <div class="quick-actions">
          <a class="button" href="/students/add"><i class="fa-solid fa-user-plus" aria-hidden="true"></i>Add Student</a>
          <a class="button" href="/fees#record-payment"><i class="fa-solid fa-money-bill-wave" aria-hidden="true"></i>Record Payment</a>
          <a class="button secondary" href="#defaulters"><i class="fa-regular fa-comment-dots" aria-hidden="true"></i>Send SMS</a>
        </div>
      </article>
    </section>
  <% } else if (user.role === 'parent' || user.role === 'student') { %>
    <section class="panel dashboard-panel">
      <h2><%= user.role === 'parent' ? 'Parent Portal' : 'Student Portal' %></h2>
      <% if (data.student) { %>
        <p><strong><%= data.student.name %></strong> · Admission <%= data.student.admissionNo %> · <%= data.student.class || 'Class not assigned' %></p>
        <div class="portal-summary">
          <div class="portal-item">Fee balance<strong>KES <%= Number((data.fees || []).reduce((total, fee) => total + Number(fee.balance || 0), 0)).toLocaleString() %></strong></div>
          <div class="portal-item">Grades available<strong><%= (data.grades || []).length %></strong></div>
        </div>
        <div class="portal-links"><a class="button" href="/fees">View fees</a><a class="button secondary" href="/grades">View grades</a><a class="button secondary" href="/attendance">View attendance</a></div>
      <% } else { %><p>No student record is linked to this account. Contact the school office to link your account.</p><% } %>
    </section>
    <% if (data.student) { %>
      <section class="dashboard-grid">
        <article class="panel dashboard-panel">
          <h2>Recent Grades</h2>
          <% if (data.grades?.length) { %><div class="table-wrap"><table><thead><tr><th>Subject</th><th>Term</th><th>Score</th><th>Level</th></tr></thead><tbody><% data.grades.forEach(grade => { %><tr><td><%= grade.subject %></td><td><%= grade.term %></td><td><%= grade.score ?? '—' %></td><td><%= grade.grade || '—' %></td></tr><% }) %></tbody></table></div><% } else { %><p class="empty-state">No grades are available for this term.</p><% } %>
        </article>
        <article class="panel dashboard-panel">
          <h2>Fee Summary</h2>
          <% if (data.fees?.length) { %><div class="table-wrap"><table><thead><tr><th>Term</th><th>Total</th><th>Paid</th><th>Balance</th></tr></thead><tbody><% data.fees.forEach(fee => { %><tr><td><%= fee.term %></td><td>KES <%= Number(fee.total_amount || 0).toLocaleString() %></td><td>KES <%= Number(fee.paid_amount || 0).toLocaleString() %></td><td class="balance-alert">KES <%= Number(fee.balance || 0).toLocaleString() %></td></tr><% }) %></tbody></table></div><% } else { %><p class="empty-state">No fee records are available for this term.</p><% } %>
        </article>
      </section>
    <% } %>
  <% } else { %>
    <section class="panel dashboard-panel">
      <h2>My Classes</h2>
      <% if (data.classes?.length) { %><div class="table-wrap"><table><thead><tr><th>Class</th><th>Stream</th></tr></thead><tbody><% data.classes.forEach(item => { %><tr><td><%= item.name %></td><td><%= item.stream || '—' %></td></tr><% }) %></tbody></table></div><% } else { %><p>No classes are currently assigned.</p><% } %>
      <div class="portal-links"><a class="button" href="/attendance">Take attendance</a><a class="button" href="/grades">Enter grades</a><a class="button secondary" href="/students">View students</a></div>
    </section>
  <% } %>
</main>

<% if (user.role === 'admin') { %>
  <script>
    const feeCollection = <%- JSON.stringify(chartData.feesByTerm || []).replace(/</g, '\\u003c') %>;
    const selectedTerm = <%- JSON.stringify(selectedTerm || '').replace(/</g, '\\u003c') %>;
    const selectedIndex = feeCollection.findIndex(item => item.term === selectedTerm);
    const comparison = selectedIndex >= 0 ? feeCollection[selectedIndex + 1] : null;
    if (comparison) {
      const current = feeCollection[selectedIndex];
      document.getElementById("feesCollectedTrend").textContent = comparison.collected > 0
        ? `${(((current.collected - comparison.collected) / comparison.collected) * 100).toFixed(1)}% vs previous term`
        : "no previous-term baseline";
      document.getElementById("feesBalanceTrend").textContent = comparison.balance > 0
        ? `${(((current.balance - comparison.balance) / comparison.balance) * 100).toFixed(1)}% vs previous term`
        : "no previous-term baseline";
    } else {
      document.getElementById("feesCollectedTrend").textContent = "no previous-term comparison";
      document.getElementById("feesBalanceTrend").textContent = "no previous-term comparison";
    }
    new Chart(document.getElementById("feeCollectionChart"), {
      type: "bar",
      data: {
        labels: feeCollection.map(item => item.term),
        datasets: [
          { label: "Collected (KES)", data: feeCollection.map(item => item.collected), backgroundColor: "#16A34A", borderRadius: 6 },
          { label: "Balance (KES)", data: feeCollection.map(item => item.balance), backgroundColor: "#F97316", borderRadius: 6 }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true, ticks: { callback: value => "KES " + Number(value).toLocaleString() } } },
        plugins: { legend: { position: "bottom" } }
      }
    });
    document.querySelectorAll(".sms-button").forEach(button => {
      button.addEventListener("click", async () => {
        button.disabled = true;
        try {
          const response = await fetch("/api/sms/send", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ studentId: button.dataset.studentId })
          });
          const result = await response.json();
          alert(result.message || "SMS service is not configured.");
        } catch (error) {
          alert("Could not contact the SMS service. Please try again.");
        } finally {
          button.disabled = false;
        }
      });
    });
  </script>
<% } %>
<%- include('_footer') %>
