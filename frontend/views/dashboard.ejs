<%- include('_header', { user }) %>
<% if (user.role === 'admin') { %><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><% } %>
<style>
  .dashboard { max-width: 1240px; }
  .welcome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 26px 30px;
    margin-bottom: 24px;
    background: linear-gradient(120deg, #111827 50%, #1A1A38);
  }
  .welcome h1 { margin: 0 0 6px; }
  .welcome p { margin: 0; color: #94A3B8; }
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 8px 13px;
    border: 1px solid #3B3B70;
    border-radius: 999px;
    background: #24234B;
    color: #C7D2FE;
    font-size: 12px;
    font-weight: 700;
    text-transform: capitalize;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 22px;
  }
  .stat-card {
    min-height: 174px;
    padding: 22px;
    border: 1px solid #263245;
    border-radius: 16px;
    background: #111827;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .18);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, .32);
  }
  .stat-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    margin-bottom: 17px;
    border-radius: 13px;
    font-size: 16px;
  }
  .stat-icon.indigo { background: #24234B; color: #A5B4FC; }
  .stat-icon.emerald { background: #12332C; color: #6EE7B7; }
  .stat-icon.amber { background: #382B18; color: #FCD34D; }
  .stat-icon.violet { background: #30234A; color: #C4B5FD; }
  .stat-icon.rose { background: #3B202B; color: #FDA4AF; }
  .stat-label { margin: 0 0 7px; color: #94A3B8; font-size: 12px; font-weight: 600; }
  .stat-value { margin: 0; color: #F1F5F9; font-size: clamp(1.55rem, 3vw, 2rem); font-weight: 800; letter-spacing: -.05em; }
  .dashboard-panel { padding: 24px; margin-bottom: 20px; }
  .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
  .panel-heading h2 { margin: 0; }
  .panel-heading a { color: #A5B4FC; font-size: 12px; font-weight: 700; text-decoration: none; }
  .panel-heading a:hover { color: #C7D2FE; }
  .overview-grid, .chart-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .chart-card { min-height: 330px; padding: 24px; }
  .chart-card canvas { max-height: 245px; }
  .overview-total { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 14px 0; border-bottom: 1px solid #263245; }
  .overview-total:last-of-type { border-bottom: 0; }
  .overview-total span { color: #94A3B8; font-size: 13px; }
  .overview-total strong { color: #F1F5F9; font-size: 18px; }
  .overview-note { margin: 14px 0 0; font-size: 12px; }
  .action-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .action-links a { text-decoration: none; }
  .percentage-track { height: 9px; overflow: hidden; border-radius: 99px; background: #334155; }
  .percentage-track span { display: block; height: 100%; border-radius: inherit; background: #4F46E5; }
  .attendance-score { margin: 4px 0 12px; color: #4F46E5; font-size: 30px; font-weight: 800; }
  .dashboard ul { padding-left: 20px; color: #CBD5E1; line-height: 1.9; }
  @media (max-width: 760px) {
    .stats-grid { grid-template-columns: 1fr; }
    .overview-grid, .chart-grid { grid-template-columns: 1fr; }
    .welcome { align-items: flex-start; flex-direction: column; padding: 22px; }
  }
</style>
<main class="dashboard">
  <section class="welcome">
    <div>
      <h1>Welcome, <%= user.name %></h1>
      <p>Here is your school overview and the latest activity.</p>
    </div>
    <span class="badge"><%= user.role %></span>
  </section>

  <% if (user.role === 'admin') { %>
    <section class="stats-grid" aria-label="School statistics">
      <article class="stat-card"><span class="stat-icon indigo"><i class="fa-solid fa-user-graduate" aria-hidden="true"></i></span><p class="stat-label">Students</p><p class="stat-value"><%= data.totalStudents %></p></article>
      <article class="stat-card"><span class="stat-icon emerald"><i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i></span><p class="stat-label">Teachers</p><p class="stat-value"><%= data.totalTeachers %></p></article>
      <article class="stat-card"><span class="stat-icon amber"><i class="fa-solid fa-people-group" aria-hidden="true"></i></span><p class="stat-label">Parents</p><p class="stat-value"><%= data.totalParents %></p></article>
      <article class="stat-card"><span class="stat-icon violet"><i class="fa-solid fa-users" aria-hidden="true"></i></span><p class="stat-label">Users</p><p class="stat-value"><%= data.totalUsers %></p></article>
      <article class="stat-card"><span class="stat-icon emerald"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span><p class="stat-label">Fees Collected</p><p class="stat-value"><%= Number(data.totalFeesCollected).toFixed(2) %></p></article>
      <article class="stat-card"><span class="stat-icon rose"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i></span><p class="stat-label">Fees Pending</p><p class="stat-value"><%= Number(data.totalFeesPending).toFixed(2) %></p></article>
    </section>

    <section class="panel dashboard-panel">
      <div class="panel-heading"><h2>Administration</h2></div>
      <div class="action-links">
        <a class="button" href="/students"><i class="fa-solid fa-user-graduate" aria-hidden="true"></i>Manage Students</a>
        <a class="button" href="/users"><i class="fa-solid fa-users" aria-hidden="true"></i>Manage Users</a>
        <a class="button" href="/debug"><i class="fa-solid fa-database" aria-hidden="true"></i>Debug Schema</a>
      </div>
    </section>

    <section class="overview-grid">
      <article class="panel dashboard-panel">
        <div class="panel-heading"><h2>Recent Students</h2><a href="/students">View all</a></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Name</th><th>Admission No.</th><th>Class</th></tr></thead>
            <tbody>
              <% if (data.recentStudents && data.recentStudents.length) { %>
                <% data.recentStudents.forEach(student => { %><tr><td><%= student.name %></td><td><%= student.admissionNo %></td><td><%= student.class || '—' %></td></tr><% }); %>
              <% } else { %>
                <tr><td colspan="3">No student records yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </article>
      <article class="panel dashboard-panel">
        <div class="panel-heading"><h2>Fee Overview</h2><a href="/fees">Open fees</a></div>
        <div class="overview-total"><span>Fees collected</span><strong><%= Number(data.totalFeesCollected).toFixed(2) %></strong></div>
        <div class="overview-total"><span>Fees pending</span><strong><%= Number(data.totalFeesPending).toFixed(2) %></strong></div>
        <p class="overview-note">Detailed payment activity and term records are available in Fees.</p>
      </article>
    </section>

    <section class="chart-grid">
      <div class="panel chart-card"><h2>Today's Attendance</h2><canvas id="attendanceChart"></canvas></div>
      <div class="panel chart-card"><h2>Performance by Class</h2><canvas id="performanceChart"></canvas></div>
      <div class="panel chart-card"><h2>Fees Collection</h2><canvas id="feesChart"></canvas></div>
      <div class="panel chart-card"><h2>Students by Class</h2><canvas id="studentCountChart"></canvas></div>
    </section>
  <% } else if (user.role === 'teacher') { %>
    <section class="panel dashboard-panel">
      <h2>My Classes</h2>
      <% if (data.classes && data.classes.length) { %><ul><% data.classes.forEach(item => { %><li><%= item.name %> <%= item.stream || '' %></li><% }); %></ul><% } else { %><p>No classes assigned.</p><% } %>
      <div class="action-links"><a class="button" href="/grades#add">Add Grade</a><a class="button" href="/attendance">Mark Today's Attendance</a></div>
    </section>
  <% } else { %>
    <section class="panel dashboard-panel">
      <h2><%= user.role === 'parent' ? 'Child Information' : 'My Information' %></h2>
      <% if (data.student) { %><p><strong>Name:</strong> <%= data.student.name %></p><p><strong>Class:</strong> <%= data.student.class %></p><% } else { %><p>No linked student record found.</p><% } %>
    </section>
    <section class="panel dashboard-panel" id="grades">
      <h2><%= user.role === 'parent' ? 'Latest Child Grades' : 'Latest Grades' %></h2>
      <% if (data.grades && data.grades.length) { %><div class="table-wrap"><table><thead><tr><th>Subject</th><th>Term</th><th>Score</th></tr></thead><tbody><% data.grades.forEach(grade => { %><tr><td><%= grade.subject %></td><td><%= grade.term %></td><td><%= grade.score %></td></tr><% }); %></tbody></table></div><% } else { %><p>No grades available.</p><% } %>
    </section>
    <section class="panel dashboard-panel" id="attendance">
      <h2><%= user.role === 'parent' ? 'Child Attendance' : 'My Attendance' %></h2>
      <p class="attendance-score"><%= data.attendanceSummary ? data.attendanceSummary.percentage : 0 %>%</p>
      <div class="percentage-track"><span style="width:<%= data.attendanceSummary ? data.attendanceSummary.percentage : 0 %>%"></span></div>
      <% if (data.attendance && data.attendance.length) { %><div class="table-wrap" style="margin-top:18px"><table><thead><tr><th>Date</th><th>Status</th></tr></thead><tbody><% data.attendance.forEach(record => { %><tr><td><%= record.date %></td><td><%= record.status %></td></tr><% }); %></tbody></table></div><% } else { %><p>No attendance records available.</p><% } %>
    </section>
  <% } %>
</main>
<% if (user.role === 'admin') { %>
  <script>
    const chartData = <%- JSON.stringify(chartData) %>;
    const chartColors = ['#4F46E5', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4'];
    Chart.defaults.color = '#CBD5E1';
    Chart.defaults.borderColor = '#334155';
    new Chart(document.getElementById('attendanceChart'), { type: 'doughnut', data: { labels: ['Present', 'Absent', 'Late'], datasets: [{ data: [chartData.attendanceStats.present, chartData.attendanceStats.absent, chartData.attendanceStats.late], backgroundColor: ['#10b981', '#ef4444', '#f59e0b'], borderWidth: 0 }] }, options: { plugins: { legend: { position: 'bottom' } }, maintainAspectRatio: false } });
    new Chart(document.getElementById('performanceChart'), { type: 'bar', data: { labels: chartData.classPerformance.map(item => item.class), datasets: [{ label: 'Average score', data: chartData.classPerformance.map(item => item.avg), backgroundColor: '#4F46E5', borderRadius: 6 }] }, options: { scales: { y: { beginAtZero: true, max: 100 } }, maintainAspectRatio: false } });
    new Chart(document.getElementById('feesChart'), { type: 'line', data: { labels: chartData.feesMonthly.map(item => item.month), datasets: [{ label: 'Collected', data: chartData.feesMonthly.map(item => item.total), borderColor: '#10b981', backgroundColor: '#10b98122', fill: true, tension: .35 }] }, options: { scales: { y: { beginAtZero: true } }, maintainAspectRatio: false } });
    new Chart(document.getElementById('studentCountChart'), { type: 'bar', data: { labels: chartData.studentCounts.map(item => item.class), datasets: [{ label: 'Students', data: chartData.studentCounts.map(item => item.count), backgroundColor: chartColors, borderRadius: 6 }] }, options: { scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }, maintainAspectRatio: false } });
  </script>
<% } %>
<%- include('_footer') %>
