<%- include('_header', { user }) %>
<style>
  .form-card { max-width: 620px; margin: 0 auto; }
  .form-card form { display: grid; gap: 16px; }
</style>
<main>
  <section class="panel form-card">
    <h1>Add New Student</h1>
    <form action="/students/add" method="POST">
      <label>Full name<input name="name" placeholder="Full name" required></label>
      <label>Admission number<input name="admissionNo" placeholder="Admission number" required></label>
      <label>Class<input name="class" placeholder="Class e.g. 7A"></label>
      <label>Parent phone<input name="parentContact" placeholder="Parent phone"></label>
      <button type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i>Save Student</button>
    </form>
  </section>
</main>
<%- include('_footer') %>
