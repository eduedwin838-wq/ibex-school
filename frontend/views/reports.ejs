<%- include('_header', { user }) %>
<style>
  .search-form { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 16px; }
  .search-form input { width: min(100%, 360px); }
  .summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 20px 0; }
  .metric-card { padding: 16px; border: 1px solid #dce2e9; border-radius: 6px; background: #f5f7fa; color: #657386; font-size: 12px; }
  .metric { margin-top: 6px; color: #285b87; font-size: 1.8rem; font-weight: 700; }
  @media (max-width: 600px) { .summary { grid-template-columns: 1fr; } }
</style>
<main>
  <% if (canManage) { %>
    <section class="panel">
      <h1>Find Student Report</h1>
      <form class="search-form" method="GET" action="/reports">
        <input name="search" value="<%= search %>" placeholder="Search name or admission no">
        <button type="submit"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>Search</button>
      </form>
      <% if (students.length) { %>
        <div class="table-wrap"><table><thead><tr><th>Name</th><th>Admission No.</th><th>Class</th><th>Report</th></tr></thead><tbody>
          <% students.forEach(student => { %><tr><td><%= student.name %></td><td><%= student.admissionNo %></td><td><%= student.class %></td><td><a class="button" href="/reports?studentId=<%= student.id %>">View</a></td></tr><% }) %>
        </tbody></table></div>
      <% } else if (search) { %><p>No matching students.</p><% } %>
    </section>
  <% } %>
  <% if (report) { %>
    <section class="panel" id="report">
      <h1>Report Card: <%= report.student.name %></h1>
      <p>Class: <%= report.student.class || '' %></p>
      <div class="summary">
        <div class="metric-card">Mean score<div class="metric"><%= report.mean %></div></div>
        <div class="metric-card">Grade<div class="metric"><%= report.grade %></div></div>
        <div class="metric-card">Attendance<div class="metric"><%= report.attendance.percentage %>%</div></div>
      </div>
      <h2>Subject Results</h2>
      <div class="table-wrap"><table><thead><tr><th>Subject</th><th>Term</th><th>Score</th><th>Grade</th></tr></thead><tbody>
        <% report.grades.forEach(item => { const displayedGrade = item.grade || (item.score == null ? '—' : item.score >= 80 ? 'A' : item.score >= 70 ? 'B' : item.score >= 60 ? 'C' : item.score >= 50 ? 'D' : 'F'); %><tr><td><%= item.subject %></td><td><%= item.term %></td><td><%= item.score ?? '—' %></td><td><%= displayedGrade %></td></tr><% }) %>
      </tbody></table></div>
      <p><a class="button" href="/reports?studentId=<%= report.student.id %>&download=1"><i class="fa-solid fa-download" aria-hidden="true"></i>Download</a> <button type="button" onclick="window.print()">Print</button></p>
    </section>
  <% } else if (!canManage) { %>
    <section class="panel"><p>No linked student report found.</p></section>
  <% } %>
</main>
<%- include('_footer') %>
