<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Users | Ibex System</title>
  <style>
    :root { --navy: #172554; --blue: #2563eb; --ink: #172033; --line: #e5e7eb; --soft: #f5f7fb; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--soft); color: var(--ink); font-family: Arial, sans-serif; }
    nav { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; padding: 17px 5%; background: var(--navy); }
    nav a, nav span { color: white; text-decoration: none; }
    nav a:first-child { margin-right: auto; font-weight: 700; }
    main { width: 92%; max-width: 1100px; margin: 32px auto; }
    .panel { padding: 24px; background: white; border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 8px 24px #1725540d; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; min-width: 650px; border-collapse: collapse; }
    th, td { padding: 13px 11px; text-align: left; border-bottom: 1px solid var(--line); }
    th { color: #64748b; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; }
    .badge { display: inline-block; padding: 5px 10px; border-radius: 999px; color: #1e3a8a; background: #dbeafe; font-size: .78rem; font-weight: 700; text-transform: capitalize; }
    .delete { padding: 8px 11px; border: 0; border-radius: 5px; background: #b91c1c; color: white; cursor: pointer; }
  </style>
</head>
<body>
  <%- include('_header', { user }) %>
  <main>
    <section class="panel">
      <h1>User Management</h1>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Name</th><th>Email</th><th>Role</th><th>Linked ID</th><th>Action</th></tr>
          </thead>
          <tbody>
            <% if (users.length) { %>
              <% users.forEach(account => { %>
                <tr>
                  <td><%= account.name %></td>
                  <td><%= account.email %></td>
                  <td><span class="badge"><%= account.role %></span></td>
                  <td><%= account.linked_id || 'Not linked' %></td>
                  <td>
                    <form method="POST" action="/users/delete/<%= account.id %>" onsubmit="return confirm('Delete this user?');">
                      <button class="delete" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="5">No users found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
