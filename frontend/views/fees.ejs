<%- include('_header', { user }) %>
<style>
  .forms { display: grid; grid-template-columns: minmax(0, 2fr) minmax(220px, 1fr); gap: 24px; }
  .payment-form { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; }
  .payment-form label { flex: 1 1 180px; }
  .payment-form button { flex: 0 0 auto; }
  .badge { display: inline-flex; padding: 5px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; }
  .cleared { background: #12332C; color: #6EE7B7; }
  .pending { background: #3B202B; color: #FDA4AF; }
  .secondary { background: #334155; }
  .secondary:hover { background: #475569; }
  .payment-link { margin-top: 4px; }
  @media (max-width: 760px) { .forms { grid-template-columns: 1fr; } }
</style>
<main>
  <h1>Fees &amp; Payments</h1>
  <% if (user.role === 'parent' || user.role === 'student') { %>
    <section class="panel payment-link">
      <h2>Payment options</h2>
      <p>Pay securely via M-Pesa Till <strong>123456</strong>, then ask the school administrator to record your payment.</p>
      <a class="button" href="tel:*150*00%23"><i class="fa-solid fa-mobile-screen-button" aria-hidden="true"></i>Pay via Mpesa Till 123456</a>
    </section>
  <% } %>
  <% if (canManage) { %>
    <section class="panel forms">
      <div>
        <h2>Record payment</h2>
        <form class="payment-form" method="POST" action="/fees/add">
          <label>Student<select name="student_id" required><option value="">Select student</option><% students.forEach(student => { %><option value="<%= student.id %>"><%= student.name %> (<%= student.admissionNo %>)</option><% }) %></select></label>
          <label>Term<input name="term" placeholder="Term1-2026" required></label>
          <label>Amount paid<input name="paid_amount" type="number" min="0.01" step="0.01" required></label>
          <label>Method<select name="payment_method" required><option value="cash">Cash</option><option value="mpesa">M-Pesa</option><option value="bank">Bank</option></select></label>
          <label>M-Pesa code<input name="mpesa_code" maxlength="20" placeholder="Optional"></label>
          <button type="submit">Add payment</button>
        </form>
      </div>
      <div>
        <h2>Create term</h2>
        <form class="payment-form" method="POST" action="/fees/create-term">
          <label>Term<input name="term" placeholder="Term1-2026" required></label>
          <label>Total amount<input name="total_amount" type="number" min="0" step="0.01" value="15000"></label>
          <button class="secondary" type="submit">Create for all students</button>
        </form>
      </div>
    </section>
  <% } %>
  <section class="panel">
    <h2><%= canManage ? 'All fee records' : 'My fee history' %></h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Student</th><th>Term</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead>
        <tbody>
          <% if (fees.length) { fees.forEach(fee => { const balance = Number(fee.balance || 0); %>
            <tr><td><%= fee.student_name %></td><td><%= fee.term %></td><td><%= Number(fee.total_amount).toFixed(2) %></td><td><%= Number(fee.paid_amount).toFixed(2) %></td><td><strong><%= balance.toFixed(2) %></strong></td><td><span class="badge <%= balance === 0 ? 'cleared' : 'pending' %>"><%= balance === 0 ? 'CLEARED' : 'PENDING' %></span></td></tr>
          <% }) } else { %><tr><td colspan="6">No fee records found.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>
<%- include('_footer') %>
