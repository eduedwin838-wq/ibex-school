<%- include('_header', { user }) %>
<style>
  .form-card { max-width: 620px; margin: 0 auto; }
  .form-card form { display: grid; gap: 16px; }
</style>
<main>
  <section class="panel form-card">
    <h1>Edit Student: <%= student.name %></h1>
    <form method="POST" action="/students/edit/<%= student.id %>">
      <label>Name<input type="text" name="name" value="<%= student.name %>" required></label>
      <label>Admission number<input type="text" name="admissionNo" value="<%= student.admissionNo %>" required></label>
      <label>Class
        <select name="class">
          <option value="">Not assigned</option>
          <% if (student.class && !classOptions.some(item => item.value === student.class)) { %><option value="<%= student.class %>" selected><%= student.class %> (Current)</option><% } %>
          <% classOptions.forEach(item => { %><option value="<%= item.value %>" <%= item.value === student.class ? 'selected' : '' %>><%= item.name %><%= item.stream ? ` - ${item.stream}` : '' %></option><% }) %>
        </select>
      </label>
      <label>Parent phone<input type="text" name="parentContact" value="<%= student.parentContact %>"></label>
      <div><button type="submit">Update Student</button> <a class="button" href="/students">Back to Students</a></div>
    </form>
  </section>
</main>
<%- include('_footer') %>
