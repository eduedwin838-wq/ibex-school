<%- include('_header') %>
<style>
  .auth-card { width: min(560px, 100%); margin: 38px auto; padding: 32px; }
  .auth-card h1 { margin-bottom: 7px; text-align: center; }
  .auth-subtitle { margin: 0 0 24px; color: #94A3B8; text-align: center; }
  .auth-card form { display: grid; gap: 13px; }
  .auth-card form button { width: 100%; margin-top: 5px; }
  .auth-error { padding: 12px 14px; border-radius: 9px; background: #3B202B; color: #FDA4AF; font-size: 13px; }
  .auth-footnote { margin: 20px 0 0; text-align: center; font-size: 13px; }
  .auth-footnote a { color: #4F46E5; font-weight: 700; text-decoration: none; }
  @media (max-width: 600px) { .auth-card { margin: 24px auto; padding: 22px; } }
</style>
<main>
  <section class="panel auth-card">
    <h1>Create Account</h1>
    <p class="auth-subtitle">Ibex Student Management System</p>
    <% if(error) { %><div class="auth-error"><%= error %></div><% } %>
    <form method="POST" action="/register">
      <label>Full name<input name="name" placeholder="Full name" required></label>
      <label>Email address<input name="email" type="email" placeholder="Email address" required></label>
      <label>Password<input name="password" type="password" placeholder="Password" required></label>
      <label>Confirm password<input name="confirmPassword" type="password" placeholder="Confirm password"></label>
      <label>Account type
        <select name="role" required>
          <option value="" disabled selected>Select role</option>
          <option value="admin">Admin</option>
          <option value="teacher">Teacher</option>
          <option value="student">Student</option>
          <option value="parent">Parent</option>
        </select>
      </label>
      <div id="studentFields" hidden>
        <label>Admission number<input name="admissionNo" placeholder="Admission number"></label>
        <label>Class<input name="class" placeholder="Class"></label>
      </div>
      <div id="teacherFields" hidden>
        <label>Subject<input name="subject" placeholder="Subject"></label>
        <label>Qualification<input name="qualification" placeholder="Qualification"></label>
        <label>TSC number<input name="tscNo" placeholder="TSC number"></label>
      </div>
      <div id="parentFields" hidden>
        <label>Child admission number<input name="childAdmissionNo" placeholder="Child admission number"></label>
        <label>Phone<input name="phone" placeholder="Phone"></label>
      </div>
      <div id="adminFields" hidden><label>Admin secret code<input name="adminSecret" placeholder="Admin secret code" type="password"></label></div>
      <button type="submit">Register</button>
    </form>
    <p class="auth-footnote">Already have an account? <a href="/login">Login here</a></p>
  </section>
</main>
<script>
  const roleSelect = document.querySelector('select[name="role"]');
  const sections = {
    student: document.getElementById("studentFields"),
    teacher: document.getElementById("teacherFields"),
    parent: document.getElementById("parentFields"),
    admin: document.getElementById("adminFields"),
  };
  roleSelect.addEventListener("change", () => {
    Object.entries(sections).forEach(([role, section]) => {
      section.hidden = role !== roleSelect.value;
    });
  });
</script>
<%- include('_footer') %>
