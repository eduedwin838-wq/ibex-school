<%- include('_header', { user }) %>
<style>
  .percentage { margin: 0 0 12px; color: #4F46E5; font-size: 2.5rem; font-weight: 800; }
  .attendance-form { display: grid; gap: 18px; }
  .attendance-form select { min-width: 145px; }
</style>
<main>
  <% if (canManage) { %>
    <section class="panel">
      <h1>Mark Attendance <span style="color:#94A3B8;font-size:14px;font-weight:500"><%= today %></span></h1>
      <form class="attendance-form" method="POST" action="/attendance/mark">
        <input type="hidden" name="date" value="<%= today %>">
        <div class="table-wrap"><table><thead><tr><th>Student</th><th>Class</th><th>Status</th></tr></thead><tbody>
          <% students.forEach(student => { %><tr><td><%= student.name %> (<%= student.admissionNo %>)</td><td><%= student.class %></td><td><select name="status[<%= student.id %>]" required><option value="present" <%= recordByStudent[student.id] === 'present' ? 'selected' : '' %>>Present</option><option value="absent" <%= recordByStudent[student.id] === 'absent' ? 'selected' : '' %>>Absent</option><option value="late" <%= recordByStudent[student.id] === 'late' ? 'selected' : '' %>>Late</option></select></td></tr><% }) %>
        </tbody></table></div>
        <button type="submit">Save Today's Attendance</button>
      </form>
    </section>
  <% } else { %>
    <section class="panel">
      <h1><%= user.role === 'parent' ? 'Child Attendance' : 'My Attendance' %></h1>
      <div class="percentage"><%= summary.percentage %>%</div>
      <p><%= summary.attended %> attended out of <%= summary.total %> recorded days. Late arrivals count as attended.</p>
      <div class="table-wrap"><table><thead><tr><th>Date</th><th>Status</th></tr></thead><tbody>
        <% records.forEach(record => { %><tr><td><%= record.date %></td><td><%= record.status %></td></tr><% }) %>
      </tbody></table></div>
    </section>
  <% } %>
</main>
<%- include('_footer') %>
