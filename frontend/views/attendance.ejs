<%- include('_header', { user }) %>
<style>
  .percentage { margin: 0 0 12px; color: #285b87; font-size: 2.5rem; font-weight: 700; }
  .attendance-form { display: grid; gap: 18px; }
  .attendance-form select { min-width: 145px; }
  .attendance-date { color: #657386; font-size: 14px; font-weight: 500; }
  .attendance-filters { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; margin-bottom: 20px; }
  .attendance-filters label { min-width: 180px; }
</style>
<main>
  <% if (canManage) { %>
    <section class="panel">
      <h1>Mark Attendance</h1>
      <form class="attendance-filters" method="GET" action="/attendance">
        <label>Date<input type="date" name="date" value="<%= date %>" required></label>
        <label>Class
          <select name="class">
            <option value="">All classes</option>
            <% availableClasses.forEach(item => { %><option value="<%= item.class %>" <%= selectedClass === item.class ? 'selected' : '' %>><%= item.class %></option><% }) %>
          </select>
        </label>
        <button type="submit">Show students</button>
      </form>
      <p class="attendance-date">Attendance for <%= date %></p>
      <form class="attendance-form" method="POST" action="/attendance/mark">
        <input type="hidden" name="date" value="<%= date %>">
        <input type="hidden" name="class" value="<%= selectedClass %>">
        <div class="table-wrap"><table><thead><tr><th>Student</th><th>Class</th><th>Status</th></tr></thead><tbody>
          <% if (students.length) { %>
            <% students.forEach(student => { %><tr><td><%= student.name %> (<%= student.admissionNo %>)</td><td><%= student.class %></td><td><select name="status[<%= student.id %>]" required><option value="present" <%= recordByStudent[student.id] === 'present' ? 'selected' : '' %>>Present</option><option value="absent" <%= recordByStudent[student.id] === 'absent' ? 'selected' : '' %>>Absent</option><option value="late" <%= recordByStudent[student.id] === 'late' ? 'selected' : '' %>>Late</option></select></td></tr><% }) %>
          <% } else { %><tr><td colspan="3">No students found for this class.</td></tr><% } %>
        </tbody></table></div>
        <% if (students.length) { %><button type="submit">Save attendance</button><% } %>
      </form>
    </section>
  <% } else { %>
    <section class="panel">
      <h1><%= user.role === 'parent' ? 'Child Attendance' : 'My Attendance' %></h1>
      <div class="percentage"><%= summary.percentage %>%</div>
      <p><%= summary.attended %> attended out of <%= summary.total %> recorded days. Late arrivals count as attended.</p>
      <div class="table-wrap"><table><thead><tr><th>Date</th><th>Status</th></tr></thead><tbody>
        <% records.forEach(record => { %><tr><td><%= record.date %></td><td><%= record.status %></td></tr><% }) %>
      </tbody></table></div>
    </section>
  <% } %>
</main>
<%- include('_footer') %>
