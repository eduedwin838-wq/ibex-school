<%- include('_header', { user }) %>
<main>
  <section class="panel">
    <div class="panel-heading">
      <h1>Students</h1>
      <a class="button" href="/students/add"><i class="fa-solid fa-plus" aria-hidden="true"></i>Add Student</a>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>ID</th><th>Name</th><th>Admission No.</th><th>Class</th><th>Parent Phone</th><th>Actions</th></tr></thead>
        <tbody>
          <% if(students.length === 0){ %>
            <tr><td colspan="6">No students found. <a href="/students/add">Add one</a></td></tr>
          <% } %>
          <% students.forEach(student => { %>
            <tr>
              <td><%= student.id %></td>
              <td><%= student.name %></td>
              <td><%= student.admissionNo %></td>
              <td><%= student.class %></td>
              <td><%= student.parentContact %></td>
              <td><a href="/students/edit/<%= student.id %>">Edit</a> · <a href="/students/delete/<%= student.id %>" onclick="return confirm('Delete?')">Delete</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>
<%- include('_footer') %>
