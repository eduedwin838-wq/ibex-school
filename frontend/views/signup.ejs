<%- include('_header') %>
<style>
  .auth-card { width: min(440px, 100%); margin: 48px auto; padding: 32px; }
  .auth-card h1 { text-align: center; }
  .auth-card form { display: grid; gap: 14px; }
  .auth-card form button { width: 100%; }
</style>
<main>
  <section class="panel auth-card">
    <h1>Register</h1>
    <form action="/register" method="POST">
      <label>Full name<input name="name" placeholder="Full name" required></label>
      <label>Email<input name="email" type="email" placeholder="Email" required></label>
      <label>Role<select name="role" required><option value="">Select role</option><option value="admin">Admin</option><option value="teacher">Teacher</option></select></label>
      <label>Password<input name="password" type="password" placeholder="Password" required></label>
      <button type="submit">Register</button>
    </form>
  </section>
</main>
<%- include('_footer') %>
