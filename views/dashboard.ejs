<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard | Student Management System</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
      }

      body {
        background: #f4f7fc;
      }

      nav {
        background: #1e3a8a;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 40px;
      }

      nav h2 {
        font-size: 24px;
      }

      nav ul {
        display: flex;
        list-style: none;
      }

      nav ul li {
        margin-left: 20px;
      }

      nav ul li a {
        color: white;
        text-decoration: none;
        font-weight: bold;
      }

      nav ul li a:hover {
        color: #ffd54f;
      }

      .container {
        width: 90%;
        margin: 40px auto;
      }

      .welcome {
        background: white;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        margin-bottom: 30px;
      }

      .welcome h1 {
        color: #1e3a8a;
        margin-bottom: 10px;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
      }

      .card {
        background: white;
        border-radius: 10px;
        padding: 25px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        text-align: center;
      }

      .card h2 {
        color: #1e3a8a;
        margin-bottom: 10px;
      }

      .card p {
        color: #666;
        margin-bottom: 20px;
      }

      .btn {
        display: inline-block;
        background: #1e3a8a;
        color: white;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 5px;
      }

      .btn:hover {
        background: #163172;
      }

      footer {
        text-align: center;
        margin-top: 50px;
        color: #777;
        padding: 20px;
      }
    </style>
  </head>

  <body>
    <nav>
      <h2>Student Management</h2>

      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/students">Students</a></li>
        <li><a href="/students/add">Add Student</a></li>
        <li><a href="/logout">Logout</a></li>
      </ul>
    </nav>

    <div class="container">
      <div class="welcome">
        <h1>Welcome, <%= user.name %> 👋</h1>
        <p>You have successfully logged into the Student Management System.</p>
      </div>

      <div class="cards">
        <div class="card">
          <h2>📚 Students</h2>
          <p>View all registered students.</p>
          <a href="/students" class="btn">View Students</a>
        </div>

        <div class="card">
          <h2>➕ Add Student</h2>
          <p>Register a new student into the system.</p>
          <a href="/students/add" class="btn">Add Student</a>
        </div>

        <div class="card">
          <h2>👤 Profile</h2>
          <p>Logged in as <strong><%= user.name %></strong></p>
          <a href="/dashboard" class="btn">Refresh</a>
        </div>

        <div class="card">
          <h2>🚪 Logout</h2>
          <p>Securely sign out of the application.</p>
          <a href="/logout" class="btn">Logout</a>
        </div>
      </div>
    </div>

    <footer>Student Management System &copy; 2026</footer>
  </body>
</html>
